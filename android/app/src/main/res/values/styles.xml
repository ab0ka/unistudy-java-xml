<resources><style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item><item name="android:colorAccent">@color/indigo</item><item name="android:windowBackground">@color/canvas</item><item name="android:statusBarColor">@color/canvas</item><item name="android:navigationBarColor">@color/surface</item></style><style name="PrimaryButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">50dp</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item><item name="android:paddingTop">10dp</item><item name="android:paddingBottom">10dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:textColor">#FFFFFF</item><item name="android:background">@drawable/bg_primary</item><item name="android:stateListAnimator">@null</item></style><style name="SecondaryButton" parent="PrimaryButton"><item name="android:textColor">@color/indigo</item><item name="android:background">@drawable/bg_secondary</item></style>
