<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#245555D9">
    <item android:id="@android:id/mask">
        <shape><solid android:color="#FFFFFF"/></shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <layer-list>
                    <item android:width="26dp" android:height="3dp" android:gravity="bottom|center_horizontal">
                        <shape>
                            <solid android:color="#A19BFA"/>
                            <corners android:radius="2dp"/>
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:drawable="@android:color/transparent"/>
        </selector>
    </item>
</ripple>
