<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/content_viewer_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F7F6FB">
    <Button android:id="@+id/content_back" android:layout_width="wrap_content" android:layout_height="48dp" android:text="← Артқа" />
    <TextView android:id="@+id/content_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="#262443" android:padding="8dp" />
    <ProgressBar android:id="@+id/content_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" />
    <TextView android:id="@+id/content_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#554C78" android:padding="8dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/content_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="Файлды алдын ала қарау" />
            <TextView android:id="@+id/content_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#262443" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/content_pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <Button android:id="@+id/content_previous" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Алдыңғы" />
        <TextView android:id="@+id/content_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#262443" />
        <Button android:id="@+id/content_next" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Келесі" />
    </LinearLayout>
    <Button android:id="@+id/content_external" android:layout_width="match_parent" android:layout_height="48dp" android:text="Басқа қолданбада ашу" />
</LinearLayout>

